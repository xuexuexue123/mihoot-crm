    <sql id="selectCrmFundpaidVo">
        select paid_id, org_id, full_name, opty_id, opty_name, interest_id, account_id, account_name, category, turn, invest_amount, chiyou_ziben, chiyou_percentage, chiyou_value, paid_date, comment, create_by, create_time, update_by, update_time from crm_fundpaid
    </sql>

    <select id="selectCrmFundpaidList" parameterType="CrmFundpaid" resultMap="CrmFundpaidResult">
        <include refid="selectCrmFundpaidVo"/>
        <where>  
            <if test="orgId != null  and orgId != ''"> and org_id = #{orgId}</if>
            <if test="fullName != null  and fullName != ''"> and full_name like concat('%', #{fullName}, '%')</if>
            <if test="optyId != null  and optyId != ''"> and opty_id = #{optyId}</if>
            <if test="optyName != null  and optyName != ''"> and opty_name like concat('%', #{optyName}, '%')</if>
            <if test="interestId != null  and interestId != ''"> and interest_id = #{interestId}</if>
            <if test="accountId != null  and accountId != ''"> and account_id = #{accountId}</if>
            <if test="accountName != null  and accountName != ''"> and account_name like concat('%', #{accountName}, '%')</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="turn != null  and turn != ''"> and turn = #{turn}</if>
            <if test="investAmount != null "> and invest_amount = #{investAmount}</if>
            <if test="chiyouZiben != null "> and chiyou_ziben = #{chiyouZiben}</if>
            <if test="chiyouPercentage != null "> and chiyou_percentage = #{chiyouPercentage}</if>
            <if test="chiyouValue != null "> and chiyou_value = #{chiyouValue}</if>
            <if test="paidDate != null "> and paid_date = #{paidDate}</if>
            <if test="comment != null  and comment != ''"> and comment = #{comment}</if>
        </where>
    </select>
    
    <select id="selectCrmFundpaidByPaidId" parameterType="String" resultMap="CrmFundpaidResult">
        <include refid="selectCrmFundpaidVo"/>
        where paid_id = #{paidId}
    </select>

    <select id="selectCrmFundpaidByInterestId" parameterType="String" resultMap="CrmFundpaidResult">
        <include refid="selectCrmFundpaidVo"/>
        where interest_id = #{interestId}
    </select>
        
    <insert id="insertCrmFundpaid" parameterType="CrmFundpaid">
