<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.crm.mapper.CrmSegmentMapper">

    <resultMap type="com.ruoyi.crm.domain.vo.SegmentVo" id="SegmentVoResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="ruleJson" column="rule_json"/>
        <result property="type" column="type"/>
        <result property="estSize" column="est_size"/>
        <result property="computedAt" column="computed_at"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap type="com.ruoyi.crm.domain.CrmSegment" id="CrmSegmentResult">
        <result property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="ruleJson" column="rule_json"/>
        <result property="type" column="type"/>
        <result property="estSize" column="est_size"/>
        <result property="computedAt" column="computed_at"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSegmentVo">
        select id, name, description, rule_json, type, est_size, computed_at, status, create_time, update_time
        from crm_segment
    </sql>

    <select id="selectList" resultMap="SegmentVoResult">
        <include refid="selectSegmentVo"/>
        where tenant_id = #{tenantId}
        order by update_time desc
    </select>

    <select id="selectById" resultMap="SegmentVoResult">
        <include refid="selectSegmentVo"/>
        where tenant_id = #{tenantId}
          and id = #{id}
        limit 1
    </select>

    <select id="selectEntityById" resultMap="CrmSegmentResult">
        select id, tenant_id, name, description, rule_json, type, est_size, computed_at, status,
               create_by, create_time, update_by, update_time
        from crm_segment
        where tenant_id = #{tenantId}
          and id = #{id}
        limit 1
    </select>

    <insert id="insertCrmSegment" parameterType="com.ruoyi.crm.domain.CrmSegment" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into crm_segment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tenantId != null and tenantId != ''">tenant_id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="description != null">description,</if>
            <if test="ruleJson != null">rule_json,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="estSize != null">est_size,</if>
            <if test="computedAt != null">computed_at,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tenantId != null and tenantId != ''">#{tenantId},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="description != null">#{description},</if>
            <if test="ruleJson != null">cast(#{ruleJson} as jsonb),</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="estSize != null">#{estSize},</if>
            <if test="computedAt != null">#{computedAt},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateCrmSegment" parameterType="com.ruoyi.crm.domain.CrmSegment">
        update crm_segment
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            description = #{description},
            <if test="ruleJson != null">rule_json = cast(#{ruleJson} as jsonb),</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="estSize != null">est_size = #{estSize},</if>
            <if test="computedAt != null">computed_at = #{computedAt},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
          and tenant_id = #{tenantId}
    </update>

    <delete id="deleteById">
        delete from crm_segment
        where id = #{id}
          and tenant_id = #{tenantId}
    </delete>
</mapper>
