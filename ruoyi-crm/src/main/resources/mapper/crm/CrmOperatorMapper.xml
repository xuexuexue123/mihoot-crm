<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.crm.mapper.CrmOperatorMapper">
    
    <resultMap type="CrmOperator" id="CrmOperatorResult">
        <result property="operatorId"    column="operator_id"    />
        <result property="operatorCategory"    column="operator_category"    />
        <result property="primaryTerritory"    column="primary_territory"    />
        <result property="operatorIdentity"    column="operator_identity"    />
        <result property="operatorPassword"    column="operator_password"    />
        <result property="operatorName"    column="operator_name"    />
        <result property="position"    column="position"    />
        <result property="avatar"    column="avatar"    />
        <result property="title"    column="title"    />
        <result property="email"    column="email"    />
        <result property="phone"    column="phone"    />
        <result property="reportTo"    column="report_to"    />
        <result property="reportToid"    column="report_toid"    />
        <result property="isActive"    column="is_active"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectCrmOperatorVo">
        select operator_id, operator_category, primary_territory, operator_identity, operator_password, operator_name, position, avatar, title, email, phone, report_to, report_toid, is_active, create_by, create_time, update_by, update_time from crm_operator
    </sql>

    <select id="selectCrmOperatorList" parameterType="CrmOperator" resultMap="CrmOperatorResult">
        <include refid="selectCrmOperatorVo"/>
        <where>  
            <if test="operatorCategory != null  and operatorCategory != ''"> and operator_category = #{operatorCategory}</if>
            <if test="primaryTerritory != null  and primaryTerritory != ''"> and primary_territory = #{primaryTerritory}</if>
            <if test="operatorIdentity != null  and operatorIdentity != ''"> and operator_identity = #{operatorIdentity}</if>
            <if test="operatorPassword != null  and operatorPassword != ''"> and operator_password = #{operatorPassword}</if>
            <if test="operatorName != null  and operatorName != ''"> and operator_name like concat('%', #{operatorName}, '%')</if>
            <if test="position != null  and position != ''"> and position = #{position}</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="email != null  and email != ''"> and email = #{email}</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="reportTo != null  and reportTo != ''"> and report_to = #{reportTo}</if>
            <if test="reportToid != null  and reportToid != ''"> and report_toid = #{reportToid}</if>
            <if test="isActive != null  and isActive != ''"> and is_active = #{isActive}</if>
        </where>
    </select>
    
    <select id="selectCrmOperatorByOperatorId" parameterType="String" resultMap="CrmOperatorResult">
        <include refid="selectCrmOperatorVo"/>
        where operator_id = #{operatorId}
    </select>
        
    <insert id="insertCrmOperator" parameterType="CrmOperator">
        insert into crm_operator
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="operatorId != null">operator_id,</if>
            <if test="operatorCategory != null and operatorCategory != ''">operator_category,</if>
            <if test="primaryTerritory != null">primary_territory,</if>
            <if test="operatorIdentity != null">operator_identity,</if>
            <if test="operatorPassword != null">operator_password,</if>
            <if test="operatorName != null">operator_name,</if>
            <if test="position != null">position,</if>
            <if test="avatar != null">avatar,</if>
            <if test="title != null">title,</if>
            <if test="email != null">email,</if>
            <if test="phone != null">phone,</if>
            <if test="reportTo != null">report_to,</if>
            <if test="reportToid != null">report_toid,</if>
            <if test="isActive != null">is_active,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="operatorId != null">#{operatorId},</if>
            <if test="operatorCategory != null and operatorCategory != ''">#{operatorCategory},</if>
            <if test="primaryTerritory != null">#{primaryTerritory},</if>
            <if test="operatorIdentity != null">#{operatorIdentity},</if>
            <if test="operatorPassword != null">#{operatorPassword},</if>
            <if test="operatorName != null">#{operatorName},</if>
            <if test="position != null">#{position},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="title != null">#{title},</if>
            <if test="email != null">#{email},</if>
            <if test="phone != null">#{phone},</if>
            <if test="reportTo != null">#{reportTo},</if>
            <if test="reportToid != null">#{reportToid},</if>
            <if test="isActive != null">#{isActive},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateCrmOperator" parameterType="CrmOperator">
        update crm_operator
        <trim prefix="SET" suffixOverrides=",">
            <if test="operatorCategory != null and operatorCategory != ''">operator_category = #{operatorCategory},</if>
            <if test="primaryTerritory != null">primary_territory = #{primaryTerritory},</if>
            <if test="operatorIdentity != null">operator_identity = #{operatorIdentity},</if>
            <if test="operatorPassword != null">operator_password = #{operatorPassword},</if>
            <if test="operatorName != null">operator_name = #{operatorName},</if>
            <if test="position != null">position = #{position},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="title != null">title = #{title},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="reportTo != null">report_to = #{reportTo},</if>
            <if test="reportToid != null">report_toid = #{reportToid},</if>
            <if test="isActive != null">is_active = #{isActive},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where operator_id = #{operatorId}
    </update>

    <delete id="deleteCrmOperatorByOperatorId" parameterType="String">
        delete from crm_operator where operator_id = #{operatorId}
    </delete>

    <delete id="deleteCrmOperatorByOperatorIds" parameterType="String">
        delete from crm_operator where operator_id in 
        <foreach item="operatorId" collection="array" open="(" separator="," close=")">
            #{operatorId}
        </foreach>
    </delete>
</mapper>