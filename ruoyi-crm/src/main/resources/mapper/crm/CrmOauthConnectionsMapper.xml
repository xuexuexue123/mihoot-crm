<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.crm.mapper.CrmOauthConnectionsMapper">
    
    <resultMap type="CrmOauthConnections" id="CrmOauthConnectionsResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="integrationType"    column="integration_type"    />
        <result property="provider"    column="provider"    />
        <result property="externalId"    column="external_id"    />
        <result property="externalName"    column="external_name"    />
        <result property="accessToken"    column="access_token"    />
        <result property="refreshToken"    column="refresh_token"    />
        <result property="tokenType"    column="token_type"    />
        <result property="scope"    column="scope"    />
        <result property="expiresAt"    column="expires_at"    />
        <result property="metadata"    column="metadata"    />
        <result property="connectedAt"    column="connected_at"    />
        <result property="lastRefreshedAt"    column="last_refreshed_at"    />
        <result property="revoked"    column="revoked"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectCrmOauthConnectionsVo">
        select id, user_id, integration_type, provider, external_id, external_name, access_token, refresh_token, token_type, scope, expires_at, metadata, connected_at, last_refreshed_at, revoked, created_at, updated_at, status  from crm_oauth_connections
    </sql>

    <select id="existsByExternalName" parameterType="String" resultMap="CrmOauthConnectionsResult">
        <include refid="selectCrmOauthConnectionsVo"/>
        where external_name = #{externalName}
    </select>

    <select id="selectCrmOauthConnectionsList" parameterType="CrmOauthConnections" resultMap="CrmOauthConnectionsResult">
        <include refid="selectCrmOauthConnectionsVo"/>
        <where>  
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="integrationType != null  and integrationType != ''"> and integration_type = #{integrationType}</if>
            <if test="provider != null  and provider != ''"> and provider = #{provider}</if>
            <if test="externalId != null  and externalId != ''"> and external_id = #{externalId}</if>
            <if test="externalName != null  and externalName != ''"> and external_name like concat('%', #{externalName}, '%')</if>
            <if test="accessToken != null  and accessToken != ''"> and access_token = #{accessToken}</if>
            <if test="refreshToken != null  and refreshToken != ''"> and refresh_token = #{refreshToken}</if>
            <if test="tokenType != null  and tokenType != ''"> and token_type = #{tokenType}</if>
            <if test="scope != null  and scope != ''"> and scope = #{scope}</if>
            <if test="expiresAt != null "> and expires_at = #{expiresAt}</if>
            <if test="metadata != null  and metadata != ''"> and metadata = CAST(NULLIF(TRIM(#{metadata}), '') AS jsonb)</if>
            <if test="connectedAt != null "> and connected_at = #{connectedAt}</if>
            <if test="lastRefreshedAt != null "> and last_refreshed_at = #{lastRefreshedAt}</if>
            <if test="revoked != null "> and revoked = #{revoked}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectCrmOauthConnectionsById" parameterType="String" resultMap="CrmOauthConnectionsResult">
        <include refid="selectCrmOauthConnectionsVo"/>
        where id = CAST(#{id} AS numeric)
    </select>

    <select id="selectCrmOauthConnectionsByUserId" parameterType="map" resultMap="CrmOauthConnectionsResult">
        <include refid="selectCrmOauthConnectionsVo"/>
        where user_id = #{userId} and provider = #{provider} and external_name = #{externalName}
    </select>

    <insert id="insertCrmOauthConnections" parameterType="CrmOauthConnections">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT COALESCE(MAX(id), 0) + 1 FROM crm_oauth_connections
        </selectKey>
        insert into crm_oauth_connections
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="integrationType != null">integration_type,</if>
            <if test="provider != null and provider != ''">provider,</if>
            <if test="externalId != null and externalId != ''">external_id,</if>
            <if test="externalName != null">external_name,</if>
            <if test="accessToken != null and accessToken != ''">access_token,</if>
            <if test="refreshToken != null">refresh_token,</if>
            <if test="tokenType != null">token_type,</if>
            <if test="scope != null">scope,</if>
            <if test="expiresAt != null">expires_at,</if>
            <if test="metadata != null">metadata,</if>
            <if test="connectedAt != null">connected_at,</if>
            <if test="lastRefreshedAt != null">last_refreshed_at,</if>
            <if test="revoked != null">revoked,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="userId != null and userId != ''">#{userId},</if>
            <if test="integrationType != null">#{integrationType},</if>
            <if test="provider != null and provider != ''">#{provider},</if>
            <if test="externalId != null and externalId != ''">#{externalId},</if>
            <if test="externalName != null">#{externalName},</if>
            <if test="accessToken != null and accessToken != ''">#{accessToken},</if>
            <if test="refreshToken != null">#{refreshToken},</if>
            <if test="tokenType != null">#{tokenType},</if>
            <if test="scope != null">#{scope},</if>
            <if test="expiresAt != null">#{expiresAt},</if>
            <if test="metadata != null">CAST(NULLIF(TRIM(#{metadata}), '') AS jsonb),</if>
            <if test="connectedAt != null">#{connectedAt},</if>
            <if test="lastRefreshedAt != null">#{lastRefreshedAt},</if>
            <if test="revoked != null">#{revoked},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateCrmOauthConnections" parameterType="CrmOauthConnections">
        update crm_oauth_connections
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="integrationType != null">integration_type = #{integrationType},</if>
            <if test="provider != null and provider != ''">provider = #{provider},</if>
            <if test="externalId != null and externalId != ''">external_id = #{externalId},</if>
            <if test="externalName != null">external_name = #{externalName},</if>
            <if test="accessToken != null and accessToken != ''">access_token = #{accessToken},</if>
            <if test="refreshToken != null">refresh_token = #{refreshToken},</if>
            <if test="tokenType != null">token_type = #{tokenType},</if>
            <if test="scope != null">scope = #{scope},</if>
            <if test="expiresAt != null">expires_at = #{expiresAt},</if>
            <if test="metadata != null">metadata = CAST(NULLIF(TRIM(#{metadata}), '') AS jsonb),</if>
            <if test="connectedAt != null">connected_at = #{connectedAt},</if>
            <if test="lastRefreshedAt != null">last_refreshed_at = #{lastRefreshedAt},</if>
            <if test="revoked != null">revoked = #{revoked},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where id = CAST(#{id} AS numeric)
    </update>

    <update id="updateCrmOauthConnectionsByExternalName" parameterType="CrmOauthConnections">
        update crm_oauth_connections
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="integrationType != null">integration_type = #{integrationType},</if>
            <if test="provider != null and provider != ''">provider = #{provider},</if>
            <if test="externalId != null and externalId != ''">external_id = #{externalId},</if>
            <if test="externalName != null">external_name = #{externalName},</if>
            <if test="accessToken != null and accessToken != ''">access_token = #{accessToken},</if>
            <if test="refreshToken != null">refresh_token = #{refreshToken},</if>
            <if test="tokenType != null">token_type = #{tokenType},</if>
            <if test="scope != null">scope = #{scope},</if>
            <if test="expiresAt != null">expires_at = #{expiresAt},</if>
            <if test="metadata != null">metadata = CAST(NULLIF(TRIM(#{metadata}), '') AS jsonb),</if>
            <if test="connectedAt != null">connected_at = #{connectedAt},</if>
            <if test="lastRefreshedAt != null">last_refreshed_at = #{lastRefreshedAt},</if>
            <if test="revoked != null">revoked = #{revoked},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where external_name = #{externalName}
    </update>

    <select id="selectCrmOauthConnectionsByUserProviderExternalId" parameterType="map" resultMap="CrmOauthConnectionsResult">
        <include refid="selectCrmOauthConnectionsVo"/>
        where user_id = #{userId} and provider = #{provider} and external_id = #{externalId}
    </select>

    <delete id="deleteManualOauthConnections" parameterType="map">
        delete from crm_oauth_connections
        where user_id = #{userId}
          and provider = #{provider}
          and external_name != #{externalName}
          and (refresh_token is null or refresh_token = '')
    </delete>

    <delete id="deleteCrmOauthConnectionsById" parameterType="String">
        delete from crm_oauth_connections where id = CAST(#{id} AS numeric)
    </delete>

    <delete id="deleteCrmOauthConnectionsByIds" parameterType="String">
        delete from crm_oauth_connections where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            CAST(#{id} AS numeric)
        </foreach>
    </delete>
</mapper>