<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.crm.mapper.WCredentialMapper">
    
    <resultMap type="WCredential" id="WCredentialResult">
        <result property="id"    column="id"    />
        <result property="name"    column="name"    />
        <result property="value"    column="value"    />
        <result property="type"    column="type"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="userId"    column="user_id"    />
        <result property="organizationId"    column="organization_id"    />
        <result property="isPrimary"    column="is_primary"    />
    </resultMap>

    <sql id="selectWCredentialVo">
        select id, name, value, type, created_at, updated_at, user_id, organization_id, is_primary from w_credential
    </sql>

    <select id="selectWCredentialList" parameterType="WCredential" resultMap="WCredentialResult">
        <include refid="selectWCredentialVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="value != null  and value != ''"> and value = #{value}</if>
            <if test="type != null  and type != ''"> and type = #{type}::"CredentialType"</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
            <if test="isPrimary != null "> and is_primary = #{isPrimary}</if>
        </where>
    </select>
    
    <select id="selectWCredentialById" parameterType="String" resultMap="WCredentialResult">
        <include refid="selectWCredentialVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertWCredential" parameterType="WCredential">
        insert into w_credential
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null and id != ''">id,</if>
            <if test="name != null and name != ''">name,</if>
            <if test="value != null and value != ''">value,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="userId != null and userId != ''">user_id,</if>
            <if test="organizationId != null and organizationId != ''">organization_id,</if>
            <if test="isPrimary != null">is_primary,</if>
            created_at,
            updated_at,
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null and id != ''">#{id},</if>
            <if test="name != null and name != ''">#{name},</if>
            <if test="value != null and value != ''">#{value},</if>
            <if test="type != null and type != ''">#{type}::"CredentialType",</if>
            <if test="userId != null and userId != ''">#{userId},</if>
            <if test="organizationId != null and organizationId != ''">#{organizationId},</if>
            <if test="isPrimary != null">#{isPrimary},</if>
            <choose>
                <when test="createdAt != null">#{createdAt},</when>
                <otherwise>now(),</otherwise>
            </choose>
            <choose>
                <when test="updatedAt != null">#{updatedAt},</when>
                <otherwise>now(),</otherwise>
            </choose>
         </trim>
    </insert>

    <update id="updateWCredential" parameterType="WCredential">
        update w_credential
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="value != null and value != ''">value = #{value},</if>
            <if test="type != null and type != ''">type = #{type}::"CredentialType",</if>
            <if test="userId != null and userId != ''">user_id = #{userId},</if>
            <if test="organizationId != null">organization_id = #{organizationId},</if>
            <if test="isPrimary != null">is_primary = #{isPrimary},</if>
            <choose>
                <when test="updatedAt != null">updated_at = #{updatedAt},</when>
                <otherwise>updated_at = now(),</otherwise>
            </choose>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWCredentialById" parameterType="String">
        delete from w_credential where id = #{id}
    </delete>

    <delete id="deleteWCredentialByIds" parameterType="String">
        delete from w_credential where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="clearPrimaryByUserAndType">
        update w_credential
        set is_primary = 0, updated_at = now()
        where user_id = #{userId}
          and type = #{type}::"CredentialType"
          <if test="excludeId != null and excludeId != ''"> and id != #{excludeId}</if>
    </update>
</mapper>
