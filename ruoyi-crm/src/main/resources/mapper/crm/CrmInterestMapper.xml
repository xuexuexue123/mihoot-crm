<mapper namespace="com.ruoyi.crm.mapper.CrmInterestMapper">
    
    <resultMap type="CrmInterest" id="CrmInterestResult">
        <result property="interestId"    column="interest_id"    />
        <result property="orgId"    column="org_id"    />
        <result property="fullName"    column="full_name"    />
        <result property="optyId"    column="opty_id"    />
        <result property="optyName"    column="opty_name"    />
        <result property="changeDate"    column="change_date"    />
        <result property="turn"    column="turn"    />
        <result property="turnAmount"    column="turn_amount"    />
        <result property="touqianValue"    column="touqian_value"    />
        <result property="touhouValue"    column="touhou_value"    />
        <result property="zhuceZiben"    column="zhuce_ziben"    />
        <result property="chiyouZiben"    column="chiyou_ziben"    />
        <result property="chiyouPercentage"    column="chiyou_percentage"    />
        <result property="chiyouValue"    column="chiyou_value"    />
        <result property="investAmount"    column="invest_amount"    />
        <result property="comment"    column="comment"    />
        <result property="createBy"    column="create_by"    />
