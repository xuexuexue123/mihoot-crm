<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.crm.mapper.CrmBulkemailMapper">
    
    <resultMap type="CrmBulkemail" id="CrmBulkemailResult">
        <result property="bulkId"    column="bulk_id"    />
        <result property="subject"    column="subject"    />
        <result property="templateId"    column="template_id"    />
        <result property="uniqueId"    column="unique_id"    />
        <result property="sender"    column="sender"    />
        <result property="recipients"    column="recipients"    />
        <result property="total"    column="total"    />
        <result property="fails"    column="fails"    />
        <result property="opens"    column="opens"    />
        <result property="replies"    column="replies"    />
        <result property="emailContent"    column="email_content"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
        <result property="sendDate"    column="send_date"    />
        <result property="spendAmount"    column="spend_amount"    />
        <result property="sendMode"    column="send_mode"    />
        <result property="scheduledAt"    column="scheduled_at"    />
        <result property="sentAt"    column="sent_at"    />
        <result property="cancelledAt"    column="cancelled_at"    />
        <result property="metadata"    column="metadata"    />
    </resultMap>

    <sql id="selectCrmBulkemailVo">
        select bulk_id, subject, template_id, unique_id, sender, recipients, total, fails, opens, replies, email_content, create_by, create_time, update_by, update_time, status, send_date, spend_amount, send_mode, scheduled_at, sent_at, cancelled_at, metadata::text as metadata from crm_bulkemail
    </sql>

    <select id="selectCrmBulkemailList" parameterType="CrmBulkemail" resultMap="CrmBulkemailResult">
        <include refid="selectCrmBulkemailVo"/>
        <where>  
            <if test="subject != null  and subject != ''"> and subject = #{subject}</if>
            <if test="templateId != null  and templateId != ''"> and template_id = #{templateId}</if>
            <if test="uniqueId != null  and uniqueId != ''"> and unique_id = #{uniqueId}</if>
            <if test="sender != null  and sender != ''"> and sender = #{sender}</if>
            <if test="recipients != null  and recipients != ''"> and recipients = #{recipients}</if>
            <if test="total != null "> and total = #{total}</if>
            <if test="fails != null "> and fails = #{fails}</if>
            <if test="opens != null "> and opens = #{opens}</if>
            <if test="replies != null "> and replies = #{replies}</if>
            <if test="emailContent != null  and emailContent != ''"> and email_content = #{emailContent}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="sendDate != null "> and send_date = #{sendDate}</if>
            <if test="sendMode != null  and sendMode != ''"> and send_mode = #{sendMode}</if>
        </where>
    </select>
    
    <select id="selectCrmBulkemailByBulkId" parameterType="String" resultMap="CrmBulkemailResult">
        <include refid="selectCrmBulkemailVo"/>
        where bulk_id = #{bulkId}
    </select>

    <select id="selectScheduledDue" resultType="String">
        select bulk_id from crm_bulkemail
        where status = 'scheduled'
          and scheduled_at is not null
          and scheduled_at &lt;= #{now}
        order by scheduled_at asc
        limit #{limit}
    </select>
        
    <insert id="insertCrmBulkemail" parameterType="CrmBulkemail">
        insert into crm_bulkemail
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bulkId != null">bulk_id,</if>
            <if test="subject != null and subject != ''">subject,</if>
            <if test="templateId != null and templateId != ''">template_id,</if>
            <if test="uniqueId != null and uniqueId != ''">unique_id,</if>
            <if test="sender != null and sender != ''">sender,</if>
            <if test="recipients != null">recipients,</if>
            <if test="total != null">total,</if>
            <if test="fails != null">fails,</if>
            <if test="opens != null">opens,</if>
            <if test="replies != null">replies,</if>
            <if test="emailContent != null">email_content,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="status != null">status,</if>
            <if test="sendDate != null">send_date,</if>
            <if test="spendAmount != null">spend_amount,</if>
            <if test="sendMode != null">send_mode,</if>
            <if test="scheduledAt != null">scheduled_at,</if>
            <if test="sentAt != null">sent_at,</if>
            <if test="cancelledAt != null">cancelled_at,</if>
            <if test="metadata != null">metadata,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bulkId != null">#{bulkId},</if>
            <if test="subject != null and subject != ''">#{subject},</if>
            <if test="templateId != null and templateId != ''">#{templateId},</if>
            <if test="uniqueId != null and uniqueId != ''">#{uniqueId},</if>
            <if test="sender != null and sender != ''">#{sender},</if>
            <if test="recipients != null">#{recipients},</if>
            <if test="total != null">#{total},</if>
            <if test="fails != null">#{fails},</if>
            <if test="opens != null">#{opens},</if>
            <if test="replies != null">#{replies},</if>
            <if test="emailContent != null">#{emailContent},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="status != null">#{status},</if>
            <if test="sendDate != null">#{sendDate},</if>
            <if test="spendAmount != null">#{spendAmount},</if>
            <if test="sendMode != null">#{sendMode},</if>
            <if test="scheduledAt != null">#{scheduledAt},</if>
            <if test="sentAt != null">#{sentAt},</if>
            <if test="cancelledAt != null">#{cancelledAt},</if>
            <if test="metadata != null">CAST(NULLIF(TRIM(#{metadata}), '') AS jsonb),</if>
         </trim>
    </insert>

    <update id="updateCrmBulkemail" parameterType="CrmBulkemail">
        update crm_bulkemail
        <trim prefix="SET" suffixOverrides=",">
            <if test="subject != null and subject != ''">subject = #{subject},</if>
            <if test="templateId != null and templateId != ''">template_id = #{templateId},</if>
            <if test="uniqueId != null and uniqueId != ''">unique_id = #{uniqueId},</if>
            <if test="sender != null and sender != ''">sender = #{sender},</if>
            <if test="recipients != null">recipients = #{recipients},</if>
            <if test="total != null">total = #{total},</if>
            <if test="fails != null">fails = #{fails},</if>
            <if test="opens != null">opens = #{opens},</if>
            <if test="replies != null">replies = #{replies},</if>
            <if test="emailContent != null">email_content = #{emailContent},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sendDate != null">send_date = #{sendDate},</if>
            <if test="spendAmount != null">spend_amount = #{spendAmount},</if>
            <if test="sendMode != null">send_mode = #{sendMode},</if>
            <if test="scheduledAt != null">scheduled_at = #{scheduledAt},</if>
            <if test="sentAt != null">sent_at = #{sentAt},</if>
            <if test="cancelledAt != null">cancelled_at = #{cancelledAt},</if>
            <if test="metadata != null">metadata = CAST(NULLIF(TRIM(#{metadata}), '') AS jsonb),</if>
        </trim>
        where bulk_id = #{bulkId}
    </update>

    <update id="tryTransitionStatus">
        update crm_bulkemail
        set status = #{toStatus},
            update_time = CURRENT_TIMESTAMP
            <if test="sendMode != null">, send_mode = #{sendMode}</if>
            <if test="scheduledAt != null">, scheduled_at = #{scheduledAt}</if>
            <if test="cancelledAt != null">, cancelled_at = #{cancelledAt}</if>
        where bulk_id = #{bulkId}
          and status in
          <foreach collection="fromStatuses" item="item" open="(" separator="," close=")">
              #{item}
          </foreach>
    </update>

    <update id="updateSendResult">
        update crm_bulkemail
        set status = #{status},
            total = #{total},
            fails = #{fails},
            sent_at = #{sentAt},
            update_time = CURRENT_TIMESTAMP
        where bulk_id = #{bulkId}
    </update>

    <delete id="deleteCrmBulkemailByBulkId" parameterType="String">
        delete from crm_bulkemail where bulk_id = #{bulkId}
    </delete>

    <delete id="deleteCrmBulkemailByBulkIds" parameterType="String">
        delete from crm_bulkemail where bulk_id in 
        <foreach item="bulkId" collection="array" open="(" separator="," close=")">
            #{bulkId}
        </foreach>
    </delete>
</mapper>
