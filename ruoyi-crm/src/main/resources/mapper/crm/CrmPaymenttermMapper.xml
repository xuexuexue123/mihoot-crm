        </trim>
        where term_id = #{termId}
    </update>

    <delete id="deleteCrmPaymenttermByTermId" parameterType="String">
        delete from crm_paymentterm where term_id = #{termId}
    </delete>

    <delete id="deleteCrmPaymenttermByTermIds" parameterType="String">
        delete from crm_paymentterm where term_id in 
        <foreach item="termId" collection="array" open="(" separator="," close=")">
            #{termId}
        </foreach>
    </delete>
</mapper>