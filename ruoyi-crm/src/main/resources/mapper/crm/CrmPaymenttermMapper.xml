<mapper namespace="com.ruoyi.crm.mapper.CrmPaymenttermMapper">
    
    <resultMap type="CrmPaymentterm" id="CrmPaymenttermResult">
        <result property="termId"    column="term_id"    />
        <result property="termName"    column="term_name"    />
        <result property="termDate"    column="term_date"    />
        <result property="termIndex"    column="term_index"    />
        <result property="paidAmount"    column="paid_amount"    />
        <result property="termAmount"    column="term_amount"    />
        <result property="contractId"    column="contract_id"    />
        <result property="contractName"    column="contract_name"    />
        <result property="accountId"    column="account_id"    />
        <result property="accountName"    column="account_name"    />
        <result property="ownerId"    column="owner_id"    />
        <result property="ownerName"    column="owner_name"    />
        <result property="isPaid"    column="is_paid"    />
        <result property="operatorName"    column="operator_name"    />
        <result property="collectDate"    column="collect_date"    />
        <result property="description"    column="description"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="userId"    column="user_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="refundAmount"    column="refund_amount"    />
        <result property="refundReason"    column="refund_reason"    />
        <result property="refundedAt"    column="refunded_at"    />
        <result property="refundedBy"    column="refunded_by"    />
    </resultMap>

    <sql id="selectCrmPaymenttermVo">
        select p.term_id, p.term_name, p.term_date, p.term_index, p.paid_amount, p.term_amount, p.contract_id, p.contract_name, p.account_id, p.account_name, p.owner_id, p.owner_name, p.is_paid, p.operator_name, p.collect_date, p.description, p.refund_amount, p.refund_reason, p.refunded_at, p.refunded_by, p.create_by, p.create_time, p.update_by, p.update_time, p.user_id, p.dept_id, p.start_date, p.end_date
        from crm_paymentterm p
         left join sys_user u on u.user_id = p.user_id
         left join sys_dept d on u.dept_id = d.dept_id
    </sql>

    <select id="selectCrmPaymenttermList" parameterType="CrmPaymentterm" resultMap="CrmPaymenttermResult">
        <include refid="selectCrmPaymenttermVo"/>
        where 1=1
            <if test="termName != null  and termName != ''"> and term_name like concat('%', #{termName}, '%')</if>
            <if test="termDate != null "> and term_date = #{termDate}</if>
            <if test="termIndex != null "> and term_index = #{termIndex}</if>
            <if test="paidAmount != null "> and paid_amount = #{paidAmount}</if>
            <if test="termAmount != null "> and term_amount = #{termAmount}</if>
            <if test="contractId != null  and contractId != ''"> and contract_id = #{contractId}</if>
            <if test="contractName != null  and contractName != ''"> and contract_name like concat('%', #{contractName}, '%')</if>
            <if test="accountId != null  and accountId != ''"> and account_id = #{accountId}</if>
            <if test="accountName != null  and accountName != ''"> and account_name like concat('%', #{accountName}, '%')</if>
            <if test="ownerId != null  and ownerId != ''"> and owner_id = #{ownerId}</if>
            <if test="ownerName != null  and ownerName != ''"> and owner_name like concat('%', #{ownerName}, '%')</if>
            <if test="isPaid != null  and isPaid != ''"> and is_paid = #{isPaid}</if>
            <if test="operatorName != null  and operatorName != ''"> and operator_name like concat('%', #{operatorName}, '%')</if>
            <if test="collectDate != null "> and collect_date = #{collectDate}</if>
            <if test="startDate != null and endDate != null "> and collect_date BETWEEN #{startDate} and #{endDate} </if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
        <!-- 数据范围过滤 -->
        ${params.dataScope}
        order by term_index
    </select>

    <select id="selectCrmPaymenttermListWeekly" parameterType="CrmPaymentterm" resultMap="CrmPaymenttermResult">
        <include refid="selectCrmPaymenttermVo"/>
        where 1=1
        and to_char(collect_date::date, 'IYYYIW') = to_char(CURRENT_DATE, 'IYYYIW')
        <if test="termName != null  and termName != ''"> and term_name like concat('%', #{termName}, '%')</if>
        <if test="termDate != null "> and term_date = #{termDate}</if>
        <if test="termIndex != null "> and term_index = #{termIndex}</if>
        <if test="paidAmount != null "> and paid_amount = #{paidAmount}</if>
        <if test="termAmount != null "> and term_amount = #{termAmount}</if>
        <if test="contractId != null  and contractId != ''"> and contract_id = #{contractId}</if>
        <if test="contractName != null  and contractName != ''"> and contract_name like concat('%', #{contractName}, '%')</if>
        <if test="accountId != null  and accountId != ''"> and account_id = #{accountId}</if>
        <if test="accountName != null  and accountName != ''"> and account_name like concat('%', #{accountName}, '%')</if>
        <if test="ownerId != null  and ownerId != ''"> and owner_id = #{ownerId}</if>
        <if test="ownerName != null  and ownerName != ''"> and owner_name like concat('%', #{ownerName}, '%')</if>
        <if test="isPaid != null  and isPaid != ''"> and is_paid = #{isPaid}</if>
        <if test="operatorName != null  and operatorName != ''"> and operator_name like concat('%', #{operatorName}, '%')</if>
        <if test="collectDate != null "> and collect_date = #{collectDate}</if>
        <if test="startDate != null and endDate != null "> and collect_date BETWEEN #{startDate} and #{endDate} </if>
        <if test="description != null  and description != ''"> and description = #{description}</if>
        <if test="userId != null "> and user_id = #{userId}</if>
        <if test="deptId != null "> and dept_id = #{deptId}</if>
        <!-- 数据范围过滤 -->
        ${params.dataScope}
        order by term_index
    </select>
    
    <select id="selectCrmPaymenttermByTermId" parameterType="String" resultMap="CrmPaymenttermResult">
        <include refid="selectCrmPaymenttermVo"/>
        where term_id = #{termId}
    </select>
        
    <insert id="insertCrmPaymentterm" parameterType="CrmPaymentterm">
        insert into crm_paymentterm
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="termId != null">term_id,</if>
            <if test="termName != null">term_name,</if>
            <if test="termDate != null">term_date,</if>
            <if test="termIndex != null">term_index,</if>
            <if test="paidAmount != null">paid_amount,</if>
            <if test="termAmount != null">term_amount,</if>
            <if test="contractId != null and contractId != ''">contract_id,</if>
            <if test="contractName != null">contract_name,</if>
            <if test="accountId != null and accountId != ''">account_id,</if>
            <if test="accountName != null">account_name,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="ownerName != null">owner_name,</if>
            <if test="isPaid != null">is_paid,</if>
            <if test="operatorName != null">operator_name,</if>
            <if test="collectDate != null">collect_date,</if>
            <if test="description != null">description,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="userId != null">user_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="refundAmount != null">refund_amount,</if>
            <if test="refundReason != null">refund_reason,</if>
            <if test="refundedAt != null">refunded_at,</if>
            <if test="refundedBy != null">refunded_by,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="termId != null">#{termId},</if>
            <if test="termName != null">#{termName},</if>
            <if test="termDate != null">#{termDate},</if>
            <if test="termIndex != null">#{termIndex},</if>
            <if test="paidAmount != null">#{paidAmount},</if>
            <if test="termAmount != null">#{termAmount},</if>
            <if test="contractId != null and contractId != ''">#{contractId},</if>
            <if test="contractName != null">#{contractName},</if>
            <if test="accountId != null and accountId != ''">#{accountId},</if>
            <if test="accountName != null">#{accountName},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="ownerName != null">#{ownerName},</if>
            <if test="isPaid != null">#{isPaid},</if>
            <if test="operatorName != null">#{operatorName},</if>
            <if test="collectDate != null">#{collectDate},</if>
            <if test="description != null">#{description},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="userId != null">#{userId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="refundAmount != null">#{refundAmount},</if>
            <if test="refundReason != null">#{refundReason},</if>
            <if test="refundedAt != null">#{refundedAt},</if>
            <if test="refundedBy != null">#{refundedBy},</if>
         </trim>
    </insert>

    <update id="updateCrmPaymentterm" parameterType="CrmPaymentterm">
        update crm_paymentterm
        <trim prefix="SET" suffixOverrides=",">
            <if test="termName != null">term_name = #{termName},</if>
            <if test="termDate != null">term_date = #{termDate},</if>
            <if test="termIndex != null">term_index = #{termIndex},</if>
            <if test="paidAmount != null">paid_amount = #{paidAmount},</if>
            <if test="termAmount != null">term_amount = #{termAmount},</if>
            <if test="contractId != null and contractId != ''">contract_id = #{contractId},</if>
            <if test="contractName != null">contract_name = #{contractName},</if>
            <if test="accountId != null and accountId != ''">account_id = #{accountId},</if>
            <if test="accountName != null">account_name = #{accountName},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="ownerName != null">owner_name = #{ownerName},</if>
            <if test="isPaid != null">is_paid = #{isPaid},</if>
            <if test="operatorName != null">operator_name = #{operatorName},</if>
            <if test="collectDate != null">collect_date = #{collectDate},</if>
            <if test="description != null">description = #{description},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
