        </trim>
        where option_id = #{optionId}
    </update>

    <delete id="deleteCrmQuoteoptionByOptionId" parameterType="String">
        delete from crm_quoteoption where option_id = #{optionId}
    </delete>

    <delete id="deleteCrmQuoteoptionByOptionIds" parameterType="String">
        delete from crm_quoteoption where option_id in 
        <foreach item="optionId" collection="array" open="(" separator="," close=")">
            #{optionId}
        </foreach>
    </delete>
</mapper>