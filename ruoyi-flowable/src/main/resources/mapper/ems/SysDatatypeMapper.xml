<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysDatatypeMapper">
    
    <resultMap type="SysDatatype" id="SysDatatypeResult">
        <result property="dataId"    column="data_id"    />
        <result property="dataSort"    column="data_sort"    />
        <result property="dataLabel"    column="data_label"    />
        <result property="dataName"    column="data_name"    />
        <result property="dataType"    column="data_type"    />
        <result property="caseTypeId"    column="case_type_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysDatatypeVo">
        select data_id, data_sort, data_label, data_name, data_type, case_type_id, create_by, create_time, update_by, update_time from sys_re_datatype
    </sql>

    <select id="selectSysDatatypeList" parameterType="SysDatatype" resultMap="SysDatatypeResult">
        <include refid="selectSysDatatypeVo"/>
        <where>  
            <if test="dataSort != null "> and data_sort = #{dataSort}</if>
            <if test="dataLabel != null  and dataLabel != ''"> and data_label = #{dataLabel}</if>
            <if test="dataName != null  and dataName != ''"> and data_name like concat('%', #{dataName}, '%')</if>
            <if test="dataType != null  and dataType != ''"> and data_type = #{dataType}</if>
            <if test="caseTypeId != null  and caseTypeId != ''"> and case_type_id = #{caseTypeId}</if>
        </where>
    </select>
    
    <select id="selectSysDatatypeByDataId" parameterType="Long" resultMap="SysDatatypeResult">
        <include refid="selectSysDatatypeVo"/>
        where data_id = #{dataId}
    </select>
        
    <insert id="insertSysDatatype" parameterType="SysDatatype" useGeneratedKeys="true" keyProperty="dataId">
        insert into sys_re_datatype
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="dataSort != null">data_sort,</if>
            <if test="dataLabel != null">data_label,</if>
            <if test="dataName != null">data_name,</if>
            <if test="dataType != null">data_type,</if>
            <if test="caseTypeId != null">case_type_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="dataSort != null">#{dataSort},</if>
            <if test="dataLabel != null">#{dataLabel},</if>
            <if test="dataName != null">#{dataName},</if>
            <if test="dataType != null">#{dataType},</if>
            <if test="caseTypeId != null">#{caseTypeId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysDatatype" parameterType="SysDatatype">
        update sys_re_datatype
        <trim prefix="SET" suffixOverrides=",">
            <if test="dataSort != null">data_sort = #{dataSort},</if>
            <if test="dataLabel != null">data_label = #{dataLabel},</if>
            <if test="dataName != null">data_name = #{dataName},</if>
            <if test="dataType != null">data_type = #{dataType},</if>
            <if test="caseTypeId != null">case_type_id = #{caseTypeId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where data_id = #{dataId}
    </update>

    <delete id="deleteSysDatatypeByDataId" parameterType="Long">
        delete from sys_re_datatype where data_id = #{dataId}
    </delete>

    <delete id="deleteSysDatatypeByDataIds" parameterType="String">
        delete from sys_re_datatype where data_id in 
        <foreach item="dataId" collection="array" open="(" separator="," close=")">
            #{dataId}
        </foreach>
    </delete>
</mapper>