<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysEmsCorresMapper">
    
    <resultMap type="SysEmsCorres" id="SysEmsCorresResult">
        <result property="corresId"    column="corres_id"    />
        <result property="category"    column="category"    />
        <result property="isbelongtocase"    column="isBelongtoCase"    />
        <result property="folderId"    column="folder_id"    />
        <result property="caseId"    column="case_id"    />
        <result property="fileTitle"    column="file_title"    />
        <result property="fileName"    column="file_name"    />
        <result property="fileType"    column="file_type"    />
        <result property="fileSize"    column="file_size"    />
        <result property="orderNum"    column="order_num"    />
        <result property="status"    column="status"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysEmsCorresVo">
        select corres_id, category, isBelongtoCase, folder_id, case_id, file_title, file_name, file_type, file_size, order_num, status, del_flag, create_by, create_time, update_by, update_time from sys_ems_corres
    </sql>

    <select id="selectSysEmsCorresList" parameterType="SysEmsCorres" resultMap="SysEmsCorresResult">
        <include refid="selectSysEmsCorresVo"/>
        <where>  
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="isbelongtocase != null  and isbelongtocase != ''"> and isBelongtoCase = #{isbelongtocase}</if>
            <if test="folderId != null "> and folder_id = #{folderId}</if>
            <if test="caseId != null "> and case_id = #{caseId}</if>
            <if test="fileTitle != null  and fileTitle != ''"> and file_title = #{fileTitle}</if>
            <if test="fileName != null  and fileName != ''"> and file_name like concat('%', #{fileName}, '%')</if>
            <if test="fileType != null  and fileType != ''"> and file_type = #{fileType}</if>
            <if test="fileSize != null "> and file_size = #{fileSize}</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>


    <select id="selectSysEmsCorresListByCaseId" parameterType="String" resultMap="SysEmsCorresResult">
        <include refid="selectSysEmsCorresVo"/>
        where case_id = #{caseId}
    </select>


    <select id="selectSysEmsCorresByCorresId" parameterType="Long" resultMap="SysEmsCorresResult">
        <include refid="selectSysEmsCorresVo"/>
        where corres_id = #{corresId}
    </select>
        
    <insert id="insertSysEmsCorres" parameterType="SysEmsCorres" useGeneratedKeys="true" keyProperty="corresId">
        insert into sys_ems_corres
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="category != null">category,</if>
            <if test="isbelongtocase != null">isBelongtoCase,</if>
            <if test="folderId != null">folder_id,</if>
            <if test="caseId != null">case_id,</if>
            <if test="fileTitle != null">file_title,</if>
            <if test="fileName != null">file_name,</if>
            <if test="fileType != null">file_type,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="category != null">#{category},</if>
            <if test="isbelongtocase != null">#{isbelongtocase},</if>
            <if test="folderId != null">#{folderId},</if>
            <if test="caseId != null">#{caseId},</if>
            <if test="fileTitle != null">#{fileTitle},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="fileType != null">#{fileType},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysEmsCorres" parameterType="SysEmsCorres">
        update sys_ems_corres
        <trim prefix="SET" suffixOverrides=",">
            <if test="category != null">category = #{category},</if>
            <if test="isbelongtocase != null">isBelongtoCase = #{isbelongtocase},</if>
            <if test="folderId != null">folder_id = #{folderId},</if>
            <if test="caseId != null">case_id = #{caseId},</if>
            <if test="fileTitle != null">file_title = #{fileTitle},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="fileType != null">file_type = #{fileType},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null">status = #{status},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where corres_id = #{corresId}
    </update>

    <delete id="deleteSysEmsCorresByCorresId" parameterType="Long">
        delete from sys_ems_corres where corres_id = #{corresId}
    </delete>

    <delete id="deleteSysEmsCorresByCorresIds" parameterType="String">
        delete from sys_ems_corres where corres_id in 
        <foreach item="corresId" collection="array" open="(" separator="," close=")">
            #{corresId}
        </foreach>
    </delete>
</mapper>