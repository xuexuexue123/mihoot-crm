<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysReActitemMapper">
    
    <resultMap type="SysReActitem" id="SysReActitemResult">
        <result property="pyId"    column="py_id"    />
        <result property="actId"    column="act_id"    />
        <result property="parentId"    column="parent_id"    />
        <result property="pySort"    column="py_sort"    />
        <result property="pyLabel"    column="py_label"    />
        <result property="pyName"    column="py_name"    />
        <result property="action"    column="action"    />
        <result property="stepPage"    column="step_page"    />
        <result property="propertyName"    column="property_name"    />
        <result property="propertyValue"    column="property_value"    />
        <result property="caseTypeId"    column="case_type_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysReActitemVo">
        select py_id, act_id, parent_id, py_sort, py_label, py_name, action, step_page, property_name, property_value, case_type_id, create_by, create_time, update_by, update_time from sys_re_actitem
    </sql>

    <select id="selectSysReActitemList" parameterType="SysReActitem" resultMap="SysReActitemResult">
        <include refid="selectSysReActitemVo"/>
        <where>  
            <if test="actId != null "> and act_id = #{actId}</if>
        </where>
        order by py_sort
    </select>
    
    <select id="selectSysReActitemByPyId" parameterType="String" resultMap="SysReActitemResult">
        <include refid="selectSysReActitemVo"/>
        where py_id = #{pyId}
    </select>
        
    <insert id="insertSysReActitem" parameterType="SysReActitem">
        insert into sys_re_actitem
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pyId != null">py_id,</if>
            <if test="actId != null">act_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="pySort != null">py_sort,</if>
            <if test="pyLabel != null">py_label,</if>
            <if test="pyName != null">py_name,</if>
            <if test="action != null">action,</if>
            <if test="stepPage != null">step_page,</if>
            <if test="propertyName != null">property_name,</if>
            <if test="propertyValue != null">property_value,</if>
            <if test="caseTypeId != null">case_type_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pyId != null">#{pyId},</if>
            <if test="actId != null">#{actId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="pySort != null">#{pySort},</if>
            <if test="pyLabel != null">#{pyLabel},</if>
            <if test="pyName != null">#{pyName},</if>
            <if test="action != null">#{action},</if>
            <if test="stepPage != null">#{stepPage},</if>
            <if test="propertyName != null">#{propertyName},</if>
            <if test="propertyValue != null">#{propertyValue},</if>
            <if test="caseTypeId != null">#{caseTypeId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysReActitem" parameterType="SysReActitem">
        update sys_re_actitem
        <trim prefix="SET" suffixOverrides=",">
            <if test="actId != null">act_id = #{actId},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="pySort != null">py_sort = #{pySort},</if>
            <if test="pyLabel != null">py_label = #{pyLabel},</if>
            <if test="pyName != null">py_name = #{pyName},</if>
            <if test="action != null">action = #{action},</if>
            <if test="stepPage != null">step_page = #{stepPage},</if>
            <if test="propertyName != null">property_name = #{propertyName},</if>
            <if test="propertyValue != null">property_value = #{propertyValue},</if>
            <if test="caseTypeId != null">case_type_id = #{caseTypeId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where py_id = #{pyId}
    </update>

    <delete id="deleteSysReActitemByPyId" parameterType="String">
        delete from sys_re_actitem where py_id = #{pyId}
    </delete>

    <delete id="deleteSysReActitemByActId" parameterType="String">
        delete from sys_re_actitem where act_id = #{actId}
    </delete>

    <delete id="deleteSysReActitemByPyIds" parameterType="String">
        delete from sys_re_actitem where py_id in 
        <foreach item="pyId" collection="array" open="(" separator="," close=")">
            #{pyId}
        </foreach>
    </delete>


    <insert id="batchSysReActitemList">
        insert into sys_re_actitem( py_id, act_id, parent_id, py_sort, py_label, py_name, step_page, action, property_name, property_value, case_type_id, create_by, create_time, update_by, update_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.pyId}, #{item.actId}, #{item.parentId}, #{item.pySort}, #{item.pyLabel}, #{item.pyName}, #{item.stepPage}, #{item.action}, #{item.propertyName}, #{item.propertyValue}, #{item.caseTypeId}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime})
        </foreach>
    </insert>
</mapper>