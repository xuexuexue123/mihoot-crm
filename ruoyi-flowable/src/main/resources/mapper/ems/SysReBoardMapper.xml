<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysReBoardMapper">
    
    <resultMap type="SysReBoard" id="SysReBoardResult">
        <result property="pyId"    column="py_id"    />
        <result property="projectId"    column="project_id"    />
        <result property="pyLabel"    column="py_label"    />
        <result property="headerColor"    column="header_color"    />
        <result property="archived"    column="archived"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="stageSort"    column="stage_sort"    />
        <collection  property="items"   javaType="java.util.List"           resultMap="SysReWorktaskResult" />
    </resultMap>


    <resultMap type="SysReWorktask" id="SysReWorktaskResult">
        <result property="taskId"    column="task_id"    />
        <result property="projectId"    column="project_id"    />
        <result property="boardId"    column="board_id"    />
        <result property="taskLabel"    column="task_label"    />
        <result property="priority"    column="priority"    />
        <result property="assignee"    column="assignee"    />
        <result property="dueDate"    column="due_date"    />
        <result property="category"    column="category"    />
        <result property="status"    column="status"    />
        <result property="description"    column="description"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="percentage"    column="percentage"    />
        <result property="planStartDate"    column="plan_start_date"    />
        <result property="planEndDate"    column="plan_end_date"    />
        <result property="realStartDate"    column="real_start_date"    />
        <result property="realEndDate"    column="real_end_date"    />
        <result property="planDuration"    column="plan_duration"    />
        <result property="humanResource"    column="human_resource"    />
        <result property="costEstimation"    column="cost_estimation"    />
        <result property="realDuration"    column="real_duration"    />
        <result property="workOrder"    column="work_order"    />
    </resultMap>

    <sql id="selectSysReBoardVo">
        select b.py_id, b.stage_sort, b.project_id, b.py_label, b.header_color, b.archived, b.create_by, b.create_time, b.update_by, b.update_time,
               w.task_id, w.work_order, w.board_id, w.task_label, w.priority, w.assignee, w.due_date, w.category, w.status, w.description, w.percentage, w.plan_start_date, w.plan_end_date, w.real_start_date, w.real_end_date, w.plan_duration, w.human_resource, w.cost_estimation, w.real_duration
        from sys_re_board b
                 left join sys_re_worktask w on b.py_id = w.board_id
    </sql>

    <sql id="selectSysReBoardVoOnly">
        select py_id, stage_sort, project_id, py_label, header_color, archived, create_by, create_time, update_by, update_time from sys_re_board
    </sql>

    <select id="selectSysReBoardOnlyList" parameterType="SysReBoard" resultMap="SysReBoardResult">
        <include refid="selectSysReBoardVoOnly"/>
        <where>
            <if test="pyId != null  and pyId != ''"> and py_id = #{pyId}</if>
            <if test="projectId != null  and projectId != ''"> and project_id = #{projectId}</if>
        </where>
        order by stage_sort
    </select>

    <select id="selectSysReBoardList" parameterType="SysReBoard" resultMap="SysReBoardResult">
        <include refid="selectSysReBoardVo"/>
        <where>  
            <if test="pyId != null  and pyId != ''"> and py_id = #{pyId}</if>
            <if test="projectId != null  and projectId != ''"> and b.project_id = #{projectId}</if>
        </where>
        order by b.stage_sort, w.work_order
    </select>
    
    <select id="selectSysReBoardByPyId" parameterType="String" resultMap="SysReBoardResult">
        <include refid="selectSysReBoardVo"/>
        where py_id = #{pyId}
    </select>

    <select id="selectSysReBoardByProjectId" parameterType="String" resultMap="SysReBoardResult">
        <include refid="selectSysReBoardVo"/>
        where b.project_id = #{projectId}
    </select>

    <insert id="insertSysReBoard" parameterType="SysReBoard">
        insert into sys_re_board
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pyId != null">py_id,</if>
            <if test="projectId != null">project_id,</if>
            <if test="pyLabel != null">py_label,</if>
            <if test="headerColor != null">header_color,</if>
            <if test="archived != null">archived,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="stageSort != null">stage_sort,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pyId != null">#{pyId},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="pyLabel != null">#{pyLabel},</if>
            <if test="headerColor != null">#{headerColor},</if>
            <if test="archived != null">#{archived},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="stageSort != null">#{stageSort},</if>
         </trim>
    </insert>

    <update id="updateSysReBoard" parameterType="SysReBoard">
        update sys_re_board
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="pyLabel != null">py_label = #{pyLabel},</if>
            <if test="headerColor != null">header_color = #{headerColor},</if>
            <if test="archived != null">archived = #{archived},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="stageSort != null">stage_sort = #{stageSort},</if>
        </trim>
        where py_id = #{pyId}
    </update>

    <delete id="deleteSysReBoardByPyId" parameterType="String">
        delete from sys_re_board where py_id = #{pyId}
    </delete>

    <delete id="deleteSysReBoardByPyIds" parameterType="String">
        delete from sys_re_board where py_id in 
        <foreach item="pyId" collection="array" open="(" separator="," close=")">
            #{pyId}
        </foreach>
    </delete>
</mapper>