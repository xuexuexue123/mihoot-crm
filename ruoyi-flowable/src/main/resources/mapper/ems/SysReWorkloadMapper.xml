<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysReWorkloadMapper">
    
    <resultMap type="SysReWorkload" id="SysReWorkloadResult">
        <result property="workloadId"    column="workload_id"    />
        <result property="taskId"    column="task_id"    />
        <result property="taskLabel"    column="task_label"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="duration"    column="duration"    />
        <result property="assignee"    column="assignee"    />
        <result property="assigneeId"    column="assignee_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysReWorkloadVo">
        select workload_id, task_id, task_label, start_date, end_date, duration, assignee, assignee_id, create_by, create_time, update_by, update_time from sys_re_workload
    </sql>

    <select id="selectSysReWorkloadList" parameterType="SysReWorkload" resultMap="SysReWorkloadResult">
        <include refid="selectSysReWorkloadVo"/>
        <where>  
            <if test="taskId != null  and taskId != ''"> and task_id = #{taskId}</if>
            <if test="taskLabel != null  and taskLabel != ''"> and task_label = #{taskLabel}</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
            <if test="duration != null "> and duration = #{duration}</if>
            <if test="assignee != null  and assignee != ''"> and assignee = #{assignee}</if>
            <if test="assigneeId != null  and assigneeId != ''"> and assignee_id = #{assigneeId}</if>
        </where>
    </select>
    
    <select id="selectSysReWorkloadByWorkloadId" parameterType="String" resultMap="SysReWorkloadResult">
        <include refid="selectSysReWorkloadVo"/>
        where workload_id = #{workloadId}
    </select>
        
    <insert id="insertSysReWorkload" parameterType="SysReWorkload">
        insert into sys_re_workload
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="workloadId != null">workload_id,</if>
            <if test="taskId != null and taskId != ''">task_id,</if>
            <if test="taskLabel != null">task_label,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="duration != null">duration,</if>
            <if test="assignee != null">assignee,</if>
            <if test="assigneeId != null">assignee_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="workloadId != null">#{workloadId},</if>
            <if test="taskId != null and taskId != ''">#{taskId},</if>
            <if test="taskLabel != null">#{taskLabel},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="duration != null">#{duration},</if>
            <if test="assignee != null">#{assignee},</if>
            <if test="assigneeId != null">#{assigneeId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysReWorkload" parameterType="SysReWorkload">
        update sys_re_workload
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskId != null and taskId != ''">task_id = #{taskId},</if>
            <if test="taskLabel != null">task_label = #{taskLabel},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="assignee != null">assignee = #{assignee},</if>
            <if test="assigneeId != null">assignee_id = #{assigneeId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where workload_id = #{workloadId}
    </update>

    <delete id="deleteSysReWorkloadByWorkloadId" parameterType="String">
        delete from sys_re_workload where workload_id = #{workloadId}
    </delete>

    <delete id="deleteSysReWorkloadByWorkloadIds" parameterType="String">
        delete from sys_re_workload where workload_id in 
        <foreach item="workloadId" collection="array" open="(" separator="," close=")">
            #{workloadId}
        </foreach>
    </delete>
</mapper>