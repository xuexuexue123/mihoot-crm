<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysReApplicationMapper">
    
    <resultMap type="SysReApplication" id="SysReApplicationResult">
        <result property="pyId"    column="py_id"    />
        <result property="pyLabel"    column="py_label"    />
        <result property="pyName"    column="py_name"    />
        <result property="organizationId"    column="organization_id"    />
        <result property="description"    column="description"    />
        <result property="businessObjectives"    column="business_objectives"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysReApplicationVo">
        select py_id, py_label, py_name, organization_id, description, business_objectives, create_by, create_time, update_by, update_time from sys_re_application
    </sql>

    <select id="selectSysReApplicationList" parameterType="SysReApplication" resultMap="SysReApplicationResult">
        <include refid="selectSysReApplicationVo"/>
        <where>  
            <if test="pyId != null  and pyId != ''"> and py_id = #{pyId}</if>
            <if test="organizationId != null  and organizationId != ''"> and organization_id = #{organizationId}</if>
        </where>
    </select>
    
    <select id="selectSysReApplicationByPyId" parameterType="String" resultMap="SysReApplicationResult">
        <include refid="selectSysReApplicationVo"/>
        where py_id = #{pyId}
    </select>
        
    <insert id="insertSysReApplication" parameterType="SysReApplication">
        insert into sys_re_application
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pyId != null">py_id,</if>
            <if test="pyLabel != null">py_label,</if>
            <if test="pyName != null">py_name,</if>
            <if test="organizationId != null">organization_id,</if>
            <if test="description != null">description,</if>
            <if test="businessObjectives != null">business_objectives,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pyId != null">#{pyId},</if>
            <if test="pyLabel != null">#{pyLabel},</if>
            <if test="pyName != null">#{pyName},</if>
            <if test="organizationId != null">#{organizationId},</if>
            <if test="description != null">#{description},</if>
            <if test="businessObjectives != null">#{businessObjectives},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysReApplication" parameterType="SysReApplication">
        update sys_re_application
        <trim prefix="SET" suffixOverrides=",">
            <if test="pyLabel != null">py_label = #{pyLabel},</if>
            <if test="pyName != null">py_name = #{pyName},</if>
            <if test="organizationId != null">organization_id = #{organizationId},</if>
            <if test="description != null">description = #{description},</if>
            <if test="businessObjectives != null">business_objectives = #{businessObjectives},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where py_id = #{pyId}
    </update>

    <delete id="deleteSysReApplicationByPyId" parameterType="String">
        delete from sys_re_application where py_id = #{pyId}
    </delete>

    <delete id="deleteSysReApplicationByPyIds" parameterType="String">
        delete from sys_re_application where py_id in 
        <foreach item="pyId" collection="array" open="(" separator="," close=")">
            #{pyId}
        </foreach>
    </delete>
</mapper>