<mapper namespace="com.ruoyi.ems.mapper.SysReDecisiontableMapper">
    
    <resultMap type="SysReDecisiontable" id="SysReDecisiontableResult">
        <result property="pyId"    column="py_id"    />
        <result property="caseTypeId"    column="case_type_id"    />
