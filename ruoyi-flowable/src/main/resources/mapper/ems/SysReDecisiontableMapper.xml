    <select id="selectSysReDecisiontableList" parameterType="SysReDecisiontable" resultMap="SysReDecisiontableResult">
        <include refid="selectSysReDecisiontableVo"/>
        <where>  
            <if test="pyId != null  and pyId != ''"> and py_id = #{pyId}</if>
            <if test="caseTypeId != null  and caseTypeId != ''"> and case_type_id = #{caseTypeId}</if>
        </where>
    </select>
    
    <select id="selectSysReDecisiontableByPyId" parameterType="String" resultMap="SysReDecisiontableResult">
        <include refid="selectSysReDecisiontableVo"/>
        where py_id = #{pyId}
    </select>
        
    <insert id="insertSysReDecisiontable" parameterType="SysReDecisiontable">
        insert into sys_re_decisiontable
        <trim prefix="(" suffix=")" suffixOverrides=",">
