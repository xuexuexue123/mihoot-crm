    <delete id="deleteSysReDecisiontableByPyId" parameterType="String">
        delete from sys_re_decisiontable where py_id = #{pyId}
    </delete>

    <delete id="deleteSysReDecisiontableByPyIds" parameterType="String">
        delete from sys_re_decisiontable where py_id in 
        <foreach item="pyId" collection="array" open="(" separator="," close=")">
