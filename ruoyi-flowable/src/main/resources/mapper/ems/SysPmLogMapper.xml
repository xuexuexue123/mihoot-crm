<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysPmLogMapper">
    
    <resultMap type="SysPmLog" id="SysPmLogResult">
        <result property="logId"    column="log_id"    />
        <result property="projectId"    column="project_id"    />
        <result property="taskId"    column="task_id"    />
        <result property="title"    column="title"    />
        <result property="messageType"    column="message_type"    />
        <result property="message"    column="message"    />
        <result property="operName"    column="oper_name"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectSysPmLogVo">
        select log_id, project_id, task_id, title, message_type, message, oper_name, status, create_by, create_time from sys_pm_log
    </sql>

    <select id="selectSysPmLogList" parameterType="SysPmLog" resultMap="SysPmLogResult">
        <include refid="selectSysPmLogVo"/>
        <where>  
            <if test="projectId != null  and projectId != ''"> and project_id = #{projectId}</if>
            <if test="taskId != null  and taskId != ''"> and task_id = #{taskId}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="messageType != null  and messageType != ''"> and message_type = #{messageType}</if>
            <if test="message != null  and message != ''"> and message = #{message}</if>
            <if test="operName != null  and operName != ''"> and oper_name like concat('%', #{operName}, '%')</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectSysPmLogByLogId" parameterType="Long" resultMap="SysPmLogResult">
        <include refid="selectSysPmLogVo"/>
        where log_id = #{logId}
    </select>
        
    <insert id="insertSysPmLog" parameterType="SysPmLog" useGeneratedKeys="true" keyProperty="logId">
        insert into sys_pm_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null and projectId != ''">project_id,</if>
            <if test="taskId != null and taskId != ''">task_id,</if>
            <if test="title != null">title,</if>
            <if test="messageType != null">message_type,</if>
            <if test="message != null">message,</if>
            <if test="operName != null">oper_name,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null and projectId != ''">#{projectId},</if>
            <if test="taskId != null and taskId != ''">#{taskId},</if>
            <if test="title != null">#{title},</if>
            <if test="messageType != null">#{messageType},</if>
            <if test="message != null">#{message},</if>
            <if test="operName != null">#{operName},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateSysPmLog" parameterType="SysPmLog">
        update sys_pm_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null and projectId != ''">project_id = #{projectId},</if>
            <if test="taskId != null and taskId != ''">task_id = #{taskId},</if>
            <if test="title != null">title = #{title},</if>
            <if test="messageType != null">message_type = #{messageType},</if>
            <if test="message != null">message = #{message},</if>
            <if test="operName != null">oper_name = #{operName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where log_id = #{logId}
    </update>

    <delete id="deleteSysPmLogByLogId" parameterType="Long">
        delete from sys_pm_log where log_id = #{logId}
    </delete>

    <delete id="deleteSysPmLogByTaskIds" parameterType="String">
        delete from sys_pm_log where task_id in
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>

    <delete id="deleteSysPmLogByLogIds" parameterType="String">
        delete from sys_pm_log where log_id in 
        <foreach item="logId" collection="array" open="(" separator="," close=")">
            #{logId}
        </foreach>
    </delete>
</mapper>