    <sql id="selectSysReProjectVo">
        select py_id, case_application_id, py_name, avatar, category, py_case_id, description, archived, owner, create_by, create_time, update_by, update_time, status, customer_name, contract_id, cost_estimation, real_cost, cpi, pv, ac, ev, spi, bac, eac, etc, duration_estimation, real_duration, stage from sys_re_project
    </sql>

    <sql id="selectSysReProjectByIdVo">
        select p.py_id, p.case_application_id, p.py_name, p.avatar, p.category, p.py_case_id, p.description, p.archived, p.owner, p.create_by, p.create_time, p.update_by, p.update_time, p.status, p.customer_name, p.contract_id, p.cost_estimation, p.real_cost, p.cpi, p.pv, p.ac, p.ev, p.spi, p.bac, p.eac, p.etc, p.duration_estimation, p.real_duration, p.stage
        from sys_re_project p
         left join sys_re_participant a on a.project_id = p.py_id
    </sql>

    <select id="selectSysReProjectList" parameterType="SysReProject" resultMap="SysReProjectResult">
        <include refid="selectSysReProjectVo"/>
        <where>
            <if test="caseApplicationId != null  and caseApplicationId != ''"> and case_application_id = #{caseApplicationId}</if>
            <if test="pyName != null  and pyName != ''"> and py_name like concat('%', #{pyName}, '%')</if>
            <if test="avatar != null  and avatar != ''"> and avatar = #{avatar}</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="pyCaseId != null  and pyCaseId != ''"> and py_case_id = #{pyCaseId}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="archived != null "> and archived = #{archived}</if>
            <if test="owner != null  and owner != ''"> and owner = #{owner}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="customerName != null  and customerName != ''"> and customer_name like concat('%', #{customerName}, '%')</if>
            <if test="contractId != null  and contractId != ''"> and contract_id = #{contractId}</if>
            <if test="costEstimation != null "> and cost_estimation = #{costEstimation}</if>
            <if test="realCost != null "> and real_cost = #{realCost}</if>
            <if test="cpi != null "> and cpi = #{cpi}</if>
            <if test="pv != null "> and pv = #{pv}</if>
            <if test="ac != null "> and ac = #{ac}</if>
            <if test="ev != null "> and ev = #{ev}</if>
            <if test="spi != null "> and spi = #{spi}</if>
            <if test="bac != null "> and bac = #{bac}</if>
            <if test="eac != null "> and eac = #{eac}</if>
            <if test="etc != null "> and etc = #{etc}</if>
            <if test="durationEstimation != null "> and duration_estimation = #{durationEstimation}</if>
            <if test="realDuration != null "> and real_duration = #{realDuration}</if>
            <if test="stage != null  and stage != ''"> and stage = #{stage}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectSysReProjectListByPartName" parameterType="String" resultMap="SysReProjectResult">
        <include refid="selectSysReProjectByIdVo"/>
        where 1=1
        and a.part_name= #{partName}
        order by create_time desc
    </select>

    <select id="selectSysReProjectByPyId" parameterType="String" resultMap="SysReProjectResult">
