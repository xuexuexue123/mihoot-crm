    </resultMap>

    <sql id="selectSysReWorktaskVo">
        select task_id, work_order, project_id, board_id, task_label, priority, assignee, due_date, category, status, description, create_by, create_time, update_by, update_time, percentage, plan_start_date, plan_end_date, real_start_date, real_end_date, plan_duration, human_resource, cost_estimation, real_duration, work_order, project_name from sys_re_worktask
    </sql>

    <sql id="selectSysReWorktaskVoWithProjectName">
        select a.task_id, a.work_order, a.project_id, a.board_id, a.task_label, a.priority, a.assignee, a.due_date, a.category, b.py_name as status, a.description, a.create_by, a.create_time, a.update_by, a.update_time, a.percentage, a.plan_start_date, a.plan_end_date, a.real_start_date, a.real_end_date, a.plan_duration, a.human_resource, a.cost_estimation, a.real_duration, a.work_order, a.project_name
        from sys_re_worktask a
                 left join sys_re_project b on a.project_id = b.py_id
    </sql>

    <select id="selectSysReWorktaskList" parameterType="SysReWorktask" resultMap="SysReWorktaskResult">
        <include refid="selectSysReWorktaskVo"/>
        <where>
            <if test="projectId != null  and projectId != ''"> and project_id = #{projectId}</if>
            <if test="boardId != null  and boardId != ''"> and board_id = #{boardId}</if>
            <if test="taskLabel != null  and taskLabel != ''"> and task_label = #{taskLabel}</if>
            <if test="priority != null  and priority != ''"> and priority = #{priority}</if>
            <if test="assignee != null  and assignee != ''"> and assignee = #{assignee}</if>
            <if test="dueDate != null "> and due_date = #{dueDate}</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="percentage != null "> and percentage = #{percentage}</if>
            <if test="planStartDate != null "> and plan_start_date = #{planStartDate}</if>
            <if test="planEndDate != null "> and plan_end_date = #{planEndDate}</if>
            <if test="realStartDate != null "> and real_start_date = #{realStartDate}</if>
            <if test="realEndDate != null "> and real_end_date = #{realEndDate}</if>
            <if test="planDuration != null "> and plan_duration = #{planDuration}</if>
            <if test="humanResource != null "> and human_resource = #{humanResource}</if>
            <if test="costEstimation != null "> and cost_estimation = #{costEstimation}</if>
            <if test="realDuration != null "> and real_duration = #{realDuration}</if>
            <if test="workOrder != null "> and work_order = #{workOrder}</if>
            <if test="projectName != null  and projectName != ''"> and project_name like concat('%', #{projectName}, '%')</if>
        </where>
        order by work_order
    </select>


    <select id="selectSysReWorktaskListByAssigneeComp" parameterType="String" resultMap="SysReWorktaskResult">
        <include refid="selectSysReWorktaskVoWithProjectName"/>
        where a.assignee = #{assignee} and a.percentage=100
        order by a.create_time
    </select>

    <select id="selectSysReWorktaskListByAssigneeWIP" parameterType="String" resultMap="SysReWorktaskResult">
        <include refid="selectSysReWorktaskVoWithProjectName"/>
        where a.assignee = #{assignee} and a.percentage!=100
        order by a.create_time
    </select>

    <select id="selectSysReWorktaskListByAssignee" parameterType="String" resultMap="SysReWorktaskResult">
        <include refid="selectSysReWorktaskVo"/>
        where assignee = #{assignee}
        order by create_time
    </select>


    <select id="selectSysReWorktaskByTaskId" parameterType="String" resultMap="SysReWorktaskResult">
        <include refid="selectSysReWorktaskVo"/>
        where task_id = #{taskId}
    </select>

