<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ems.mapper.SysReStrategyMapper">
    
    <resultMap type="SysReStrategy" id="SysReStrategyResult">
        <result property="pyId"    column="py_id"    />
        <result property="caseTypeId"    column="case_type_id"    />
        <result property="pyLabel"    column="py_label"    />
        <result property="pyName"    column="py_name"    />
        <result property="version"    column="version"    />
        <result property="resultProperty"    column="result_property"    />
        <result property="strategyHeader"    column="strategy_header"    />
        <result property="strategy"    column="strategy"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectSysReStrategyVo">
        select py_id, case_type_id, py_label, py_name, version, result_property, strategy_header, strategy, create_by, create_time, update_by, update_time from sys_re_strategy
    </sql>

    <select id="selectSysReStrategyList" parameterType="SysReStrategy" resultMap="SysReStrategyResult">
        <include refid="selectSysReStrategyVo"/>
        <where>  
            <if test="pyId != null  and pyId != ''"> and py_id = #{pyId}</if>
            <if test="caseTypeId != null  and caseTypeId != ''"> and case_type_id = #{caseTypeId}</if>
        </where>
    </select>
    
    <select id="selectSysReStrategyByPyId" parameterType="String" resultMap="SysReStrategyResult">
        <include refid="selectSysReStrategyVo"/>
        where py_id = #{pyId}
    </select>
        
    <insert id="insertSysReStrategy" parameterType="SysReStrategy">
        insert into sys_re_strategy
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pyId != null">py_id,</if>
            <if test="caseTypeId != null">case_type_id,</if>
            <if test="pyLabel != null">py_label,</if>
            <if test="pyName != null">py_name,</if>
            <if test="version != null">version,</if>
            <if test="resultProperty != null">result_property,</if>
            <if test="strategyHeader != null">strategy_header,</if>
            <if test="strategy != null">strategy,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pyId != null">#{pyId},</if>
            <if test="caseTypeId != null">#{caseTypeId},</if>
            <if test="pyLabel != null">#{pyLabel},</if>
            <if test="pyName != null">#{pyName},</if>
            <if test="version != null">#{version},</if>
            <if test="resultProperty != null">#{resultProperty},</if>
            <if test="strategyHeader != null">#{strategyHeader},</if>
            <if test="strategy != null">#{strategy},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateSysReStrategy" parameterType="SysReStrategy">
        update sys_re_strategy
        <trim prefix="SET" suffixOverrides=",">
            <if test="caseTypeId != null">case_type_id = #{caseTypeId},</if>
            <if test="pyLabel != null">py_label = #{pyLabel},</if>
            <if test="pyName != null">py_name = #{pyName},</if>
            <if test="version != null">version = #{version},</if>
            <if test="resultProperty != null">result_property = #{resultProperty},</if>
            <if test="strategyHeader != null">strategy_header = #{strategyHeader},</if>
            <if test="strategy != null">strategy = #{strategy},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where py_id = #{pyId}
    </update>

    <delete id="deleteSysReStrategyByPyId" parameterType="String">
        delete from sys_re_strategy where py_id = #{pyId}
    </delete>

    <delete id="deleteSysReStrategyByPyIds" parameterType="String">
        delete from sys_re_strategy where py_id in 
        <foreach item="pyId" collection="array" open="(" separator="," close=")">
            #{pyId}
        </foreach>
    </delete>
</mapper>